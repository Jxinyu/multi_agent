APP_ENV=development
AUTH_MODE=development
AUTH_ISSUER=https://rag-upper.local
AUTH_AUDIENCE=rag-upper-api
AUTH_JWKS_URL=
AUTH_PUBLIC_KEY_PATH=multi_domain_enterprise_project/mcp_server/public_key
AUTH_PRIVATE_KEY_PATH=multi_domain_enterprise_project/mcp_server/private_key
AUTH_ALGORITHMS=RS256
AUTH_DEV_USER_ID=user_admin_001
AUTH_DEV_USERNAME=admin
AUTH_DEV_TENANT_ID=tenant_default
AUTH_DEV_ROLE=admin
AUTH_DEV_PERMISSIONS=chat:use,kb:read,kb:write,kb:delete,audit:read
AUTH_TOKEN_TTL_SECONDS=900

DATABASE_URL=sqlite+aiosqlite:///./data/rag_upper.db
DATABASE_ECHO=false

LLAMA_PARSE_API_KEY=
LLAMA_PARSE_TIER=agentic
LLAMA_PARSE_VERSION=latest
LLAMA_PARSE_TIMEOUT_SECONDS=180
LLAMA_PARSE_MAX_RETRIES=2
DEEPSEEK_API_KEY=
XIAOAI_API_KEY=
QWEN_API_KEY=

REDIS_URL=redis://127.0.0.1:6379

MILVUS_URI=http://127.0.0.1:19530
MILVUS_DIMS=2560

NEO4J_URL=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_VLM_MODEL=qwen2.5vl:3b

RERANKER_MODEL_PATH=D:/Environment/model/bge-reranker-v2-m3
RERANKER_TOP_N=8
RERANKER_USE_FP16=false
RERANKER_MODEL_HOST_PATH=D:/Environment/model/bge-reranker-v2-m3
RETRIEVAL_CANDIDATE_TOP_K=30
RETRIEVAL_BACKEND_CANDIDATE_LIMIT=40
RETRIEVAL_FUSION_CANDIDATE_LIMIT=40
RETRIEVAL_RRF_K=60
RETRIEVAL_TIMEOUT_SECONDS=20
RETRIEVAL_MAX_CONTEXT_CHARS=12000
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2
RETRIEVAL_EVIDENCE_CACHE_TTL_SECONDS=900

MCP_RAG_URL=http://127.0.0.1:8010/rag-retriever
MCP_WEB_SEARCH_URL=
MCP_FINANCE_CHART_URL=
MCP_LEGAL_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_LOG_LEVEL=info

MAX_FILE_SIZE_BYTES=52428800
MAX_ATTACHMENT_SIZE_BYTES=10485760
MAX_FILES_PER_REQUEST=10
MAX_ATTACHMENTS_PER_REQUEST=5
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.bmp,.docx,.pptx,.xlsx,.txt,.md,.csv,.json
REQUEST_RATE_LIMIT_PER_MINUTE=60
WORKER_MAX_ATTEMPTS=3
WORKER_BLOCK_MS=5000
CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
OTEL_SERVICE_NAME=rag-upper-api
OTEL_EXPORTER_OTLP_ENDPOINT=
